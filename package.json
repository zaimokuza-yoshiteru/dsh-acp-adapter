{
  "name": "@zaimokuza/dsh-acp-adapter",
  "version": "0.1.0-rc.5",
  "description": "Use AI agents from the DSH session UI.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-client-protocol",
    "acp",
    "ai-agents"
  ],
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zaimokuza-yoshiteru/dsh-acp-adapter.git"
  },
  "bugs": "https://github.com/zaimokuza-yoshiteru/dsh-acp-adapter/issues",
  "homepage": "https://github.com/zaimokuza-yoshiteru/dsh-acp-adapter",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "toolchain": "node scripts/check-toolchain.mjs",
    "gen:typert": "node scripts/check-toolchain.mjs && node scripts/gen-typert.mjs",
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/check-toolchain.mjs && node scripts/clean.mjs && node scripts/gen-typert.mjs && tsc -p tsconfig.json && tsdown && node scripts/verify-bundle.mjs",
    "typecheck": "node scripts/check-toolchain.mjs && node scripts/gen-typert.mjs && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node scripts/check-toolchain.mjs && node scripts/gen-typert.mjs && vitest run",
    "verify": "node scripts/verify-bundle.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "check:picker-diff": "node scripts/check-upstream-picker-diff.mjs",
    "check:stale-build": "node scripts/check-stale-build.mjs",
    "prepack": "node scripts/prepack.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-attachment": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-client-connection": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-commands": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-tool": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-attachment": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-presets": "0.1.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-commands": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-tool": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-generator": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.1-rc.2",
    "@types/node": "^26.2.0",
    "lightningcss": "1.32.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "lib/host/**/*.js",
    "lib/runtime/**/*.js",
    "lib/protocol/**/*.js",
    "lib/domain/**/*.js",
    "lib/persistence/**/*.js",
    "lib/remote/**/*.js",
    "lib/host-compat/**/*.js",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ]
}
