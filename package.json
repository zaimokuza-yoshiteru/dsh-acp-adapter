      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../reference/deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-api-gateway": "link:../reference/deepseek-harness/packages/api/gateway",
    "@deepseek-ai/dsh-api-remotes": "link:../reference/deepseek-harness/packages/api/remotes",
    "@deepseek-ai/dsh-api-session-controller": "link:../reference/deepseek-harness/packages/api/session-controller",
    "@deepseek-ai/dsh-api-settings-controller": "link:../reference/deepseek-harness/packages/api/settings-controller",
    "@deepseek-ai/dsh-api-workspace-controller": "link:../reference/deepseek-harness/packages/api/workspace-controller",
    "@deepseek-ai/dsh-attachment": "link:../reference/deepseek-harness/packages/attachment/attachment",
    "@deepseek-ai/dsh-client-locale": "link:../reference/deepseek-harness/packages/client/locale",
    "@deepseek-ai/dsh-client-store": "link:../reference/deepseek-harness/packages/client/store",
    "@deepseek-ai/dsh-client-ui-chat": "link:../reference/deepseek-harness/packages/client/ui-chat",
    "@deepseek-ai/dsh-client-ui-conversation": "link:../reference/deepseek-harness/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-layout": "link:../reference/deepseek-harness/packages/client/ui-layout",
