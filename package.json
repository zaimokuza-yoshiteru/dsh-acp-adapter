    "@deepseek-ai/dsh-storage-domain": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-storage": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-subagent": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-subprocess": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-subprocess-local": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-tool-todo": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-typert-generator": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-typert-registry": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-util-time": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-util-workspace-path": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-user-approval": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-workspace": "0.1.2-alpha.3",
    "@types/node": "^26.2.0",
    "lightningcss": "1.32.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "lib/host/**/*.js",
    "lib/runtime/**/*.js",
    "lib/protocol/**/*.js",
    "lib/contract/**/*.js",
    "lib/domain/**/*.js",
    "lib/persistence/**/*.js",
    "lib/remote/**/*.js",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "cordis.patch.yml",
    "assets/readme/*.png",
    "README.md",
    "README.en.md",
    "LICENSE"
  ]
}
