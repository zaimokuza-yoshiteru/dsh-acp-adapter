    "@deepseek-ai/dsh-timeout": "link:../reference/deepseek-harness/packages/util/timeout",
    "@deepseek-ai/dsh-typert-generator": "link:../reference/deepseek-harness/packages/typert/generator",
    "@deepseek-ai/dsh-typert-protocol": "link:../reference/deepseek-harness/packages/typert/protocol",
    "@types/node": "26.2.0",
    "lightningcss": "1.32.0",
    "react": "link:../reference/deepseek-harness/apps/web/node_modules/react",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "lib/host/**/*.js",
    "lib/runtime/**/*.js",
    "lib/protocol/**/*.js",
    "lib/contract/**/*.js",
    "lib/domain/**/*.js",
    "lib/persistence/**/*.js",
    "lib/remote/**/*.js",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "cordis.patch.yml",
    "assets/readme/*.png",
    "README.md",
    "README.en.md",
    "LICENSE"
  ]
}
