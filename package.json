{
  "name": "@zaimokuza/dsh-acp-adapter",
  "version": "0.1.2-rc.1.1",
  "description": "Use AI agents from the DSH session UI.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-client-protocol",
    "acp",
    "ai-agents"
  ],
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zaimokuza-yoshiteru/dsh-acp-adapter.git"
  },
  "bugs": "https://github.com/zaimokuza-yoshiteru/dsh-acp-adapter/issues",
  "homepage": "https://github.com/zaimokuza-yoshiteru/dsh-acp-adapter",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.1.3-alpha.2"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-settings-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "external": [
        "@deepseek-ai/dsh-api-gateway/client"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "toolchain": "node scripts/check-toolchain.mjs",
    "gen:typert": "node scripts/check-toolchain.mjs && node scripts/link-dsh-reference.mjs --check && node scripts/gen-typert.mjs",
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/check-toolchain.mjs && node scripts/link-dsh-reference.mjs --check && node scripts/clean.mjs && node scripts/gen-typert.mjs && tsc -p tsconfig.json && tsdown && node scripts/verify-bundle.mjs",
    "typecheck": "node scripts/check-toolchain.mjs && node scripts/link-dsh-reference.mjs --check && node scripts/gen-typert.mjs && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node scripts/check-toolchain.mjs && node scripts/link-dsh-reference.mjs --check && node scripts/gen-typert.mjs && vitest run",
    "setup:source-reference": "node scripts/link-dsh-reference.mjs",
    "verify:source-install": "node scripts/link-dsh-reference.mjs --check",
    "verify": "node scripts/verify-bundle.mjs",
    "verify:source-reference": "node scripts/verify-dsh-reference.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "check:stale-build": "node scripts/check-stale-build.mjs",
    "prepack": "node scripts/prepack.mjs",
    "test:e2e": "node scripts/check-toolchain.mjs && node scripts/test-e2e.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-gateway": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-api-settings-controller": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-session": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-subagent": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-timeout": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.3-alpha.2",
    "react": "18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-gateway": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-settings-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-workspace-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-store": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-chat": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-layout": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-projection": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
