{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "lib",
    "declaration": true,
    "declarationDir": "lib/types",
    "sourceMap": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "@zaimokuza/dsh-acp-adapter/client": ["./src/client/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/host-compat/typert-protocol"]
}
